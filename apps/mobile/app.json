{
  "expo": {
    "name": "BeautyMade",
    "slug": "beautymade",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "beautymade",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF7F5",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.beautymade.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "내 얼굴을 3D로 만들기 위해 정면과 측면 사진을 촬영해요.",
        "NSPhotoLibraryUsageDescription": "앨범의 얼굴 사진으로 3D 얼굴을 만들 수 있어요."
      }
    },
    "android": {
      "package": "com.beautymade.app",
      "adaptiveIcon": {
        "backgroundColor": "#FCE9EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#141012",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "내 얼굴을 3D로 만들기 위해 정면과 측면 사진을 촬영해요.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "앨범의 얼굴 사진으로 3D 얼굴을 만들 수 있어요."
        }
      ],
      "expo-asset",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
