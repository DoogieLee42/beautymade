# Copy to services/api/.env to override defaults. Every setting uses the BM_ prefix.

# Required outside local development: a long random string signs login tokens and file links.
# BM_SECRET_KEY=change-me-to-a-long-random-string

# Defaults: SQLite database and files under services/api/var/
# BM_DATABASE_URL=sqlite:///./var/beautymade.db
# BM_STORAGE_DIR=./var/storage

# BM_CORS_ORIGINS=["http://localhost:8081"]
# BM_MAX_UPLOAD_MB=15
# BM_WORKER_THREADS=2

# AI high-resolution previews ("AI 고화질 보기"). Leave both keys empty to turn the feature off.
# With a Gemini key the default is Nano Banana Pro; set BM_AI_PROVIDER=openai to use GPT Image 2.
# BM_GEMINI_API_KEY=
# BM_OPENAI_API_KEY=
# BM_AI_PROVIDER=gemini
# BM_GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# BM_OPENAI_IMAGE_MODEL=gpt-image-2
# BM_AI_DAILY_LIMIT=20
